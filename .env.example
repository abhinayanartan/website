# ==============================================================================
# ABHINAYA NARTAN DANCE ACADEMY - PRODUCTION ENVIRONMENT CONFIGURATION
# Free Tier Architecture: ₹0/month
# ==============================================================================

# 1. Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
# Strictly use the public 'anon' key. NEVER expose the 'service_role' key in frontend code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Public publishable key is used by browser and server helpers. Never use service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# 2. Production Site URL (Optional, defaults to domain origin)
# Used for canonical metadata, OpenGraph tags, and auth redirect URLs
# e.g. https://abhinayanartan.com or https://abhinayanartan.github.io/website
NEXT_PUBLIC_SITE_URL=https://abhinayanartan.com

# Keep false in every production environment. Set true only for local preview
# when using the non-production demo accounts in lib/auth/demoAccounts.ts.
NEXT_PUBLIC_ENABLE_DEMO_MODE=false

# 3. Base Path (Automated in GitHub Actions; leave empty for root custom domain)
NEXT_PUBLIC_BASE_PATH=
